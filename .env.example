# Copy to .env and fill in. Never commit .env with real secrets.
# See README.md for details.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-key
DJANGO_DEBUG=1
ALLOWED_HOSTS=
FRONTEND_URL=http://localhost:5173

# Database: empty or unset = local SQLite (db.sqlite3)
# PostgreSQL example: postgresql://user:pass@localhost:5432/social_automation
DATABASE_URL=

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_TIMEZONE=America/Sao_Paulo
CELERY_ENABLE_UTC=0
# CELERY_EAGER=1

# Media and FFmpeg
MEDIA_ROOT=storage/media
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Locale / timezone
LANGUAGE_CODE=en-us
TIME_ZONE=America/Sao_Paulo

# Database secret encryption (Fernet-derived — use a strong unique string in production)
SOCIAL_ENCRYPTION_KEY=replace-with-a-strong-unique-key

# Whisper / GPU (optional)
WHISPER_DEVICE=cpu
WHISPER_MODEL=small
# WHISPER_DEBUG_GPU=0

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Provedor padrão para todas as chamadas LLM.
# Opções: xai | google | openai
LLM_PROVIDER=xai

# Modelo principal (operações complexas — Perfil C: analyze_chunks)
LLM_MODEL=grok-4-1-fast

# Modelo leve (operações simples — Perfil A/B: metadata, titles)
LLM_MODEL_LIGHT=grok-4-1-fast

# URL base da API (deixar vazio para usar o padrão do provider escolhido)
LLM_BASE_URL=

# API Key do provider escolhido
LLM_API_KEY=

# Presets prontos — copie o bloco desejado e remova os # iniciais:
#
# --- xAI / Grok ---
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4-1-fast
# LLM_MODEL_LIGHT=grok-4-1-fast
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=xai-...
#
# --- Google / Gemini ---
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# LLM_MODEL_LIGHT=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
#
# --- OpenAI / GPT ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_MODEL_LIGHT=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# Variável legada (mantida para retrocompatibilidade — preferir LLM_API_KEY)
XAI_API_KEY=

# ── Limites de cortes por análise ─────────────────────────────────────────────
# TETO de candidatos pedidos ao LLM — não é a quantidade. A quantidade sai do alvo do job
# (shorts_target/longs_target, no máximo 10 e 5 na entrega) multiplicado por
# LLM_CANDIDATE_MARGIN; estes valores só limitam o resultado.
# Subir para 15/8 é o que faz a margem valer para job de alvo grande. Mantendo 10/5, job de
# alvo 10 continua pedindo 10 candidatos, exatamente como antes da margem existir.
LLM_MAX_SHORTS=10
LLM_MAX_LONGS=5

# Margem sobre o alvo do job. O backend ainda descarta candidato por duração, por categoria
# sem brand mapeada e por nota mínima — sem folga, o job entrega menos do que pediu.
# 1.0 desliga a margem.
LLM_CANDIDATE_MARGIN=1.5

# Google / YouTube OAuth (per environment; register redirect URIs in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/social/youtube/callback/
YOUTUBE_CHECK_CLIENT_ID=
YOUTUBE_CHECK_CLIENT_SECRET=
YOUTUBE_CHECK_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/factory-check-callback/
# YOUTUBE_API_KEY=

# Upload-Post (TikTok, etc.)
# UPLOAD_POST_API_KEY=

# yt-dlp
# YTDLP_COOKIES_FILE=/absolute/path/youtube_cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
